# Database connection string (SQLite for development)
DATABASE_URL="file:./dev.db"

# Razorpay Credentials (Test Mode)
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Webhook Secret
# Used to verify incoming webhooks from Razorpay
# Set this in your Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"
