# =============================================================
# Recovr — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Database ---
# SQLite for local development. Use PostgreSQL for production.
DATABASE_URL="file:./prisma/dev.db"

# --- Session Secret ---
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 32
# Required for authentication to work.
SESSION_SECRET="change-me-to-a-random-32-char-string!!"

# Required in production. Use a distinct secret from SESSION_SECRET.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-random-secret-of-at-least-32-characters"

# --- Application ---
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Razorpay Integration (Test Mode) ---
# Get from: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_ prefix for test mode (no real money moves).
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Webhook Secret — verifies HMAC signatures on incoming webhooks.
# Set in: Razorpay Dashboard → Settings → Webhooks → Secret
# Without this set, signature verification is SKIPPED (dev only).
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# --- Email provider ---
# Optional in local simulation; required for actual outbound recovery email.
RESEND_API_KEY="re_replace_with_resend_api_key"

# --- Email provider webhooks ---
# Required to accept authentic Resend delivery callbacks in every environment.
# Copy the signing secret (whsec_...) from the Resend webhook settings.
RESEND_WEBHOOK_SECRET="whsec_replace_with_resend_webhook_signing_secret"

# --- AI Provider ---
# Options: "zai" (default, no key needed), "openai", "anthropic"
AI_PROVIDER="zai"

# Required if AI_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."

# Required if AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Redis / BullMQ ---
# Used for durable recovery job queuing.
# If Redis is unavailable, the app falls back to synchronous execution (dev only).
REDIS_URL="redis://localhost:6379"
