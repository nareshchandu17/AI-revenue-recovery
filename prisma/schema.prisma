generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =================================================================
// AI Revenue Recovery — Domain Schema
//
// Money representation: All monetary amounts are stored as integers
// representing the smallest currency unit (paise for INR, cents for
// USD, etc.). This avoids floating-point precision issues entirely.
// Divide by 100 to get the human-readable amount.
// =================================================================

// --- Enums --------------------------------------------------------

enum PaymentStatus {
  created
  authorized
  captured
  refunded
  failed
  cancelled
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  emi
}

enum CheckoutStatus {
  created
  completed
  abandoned
  expired
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  past_due
  trialing
}

enum RecoveryCaseStatus {
  detected
  diagnosing
  diagnosed
  awaiting_approval
  executing
  completed
  failed
  dismissed
}

enum RecoveryAction {
  retry_payment
  send_reminder
  offer_discount
  payment_link
  update_payment_method
  cancel_and_refund
  escalate_to_merchant
  no_action
}

enum RecoveryAttemptStatus {
  pending
  queued
  running
  succeeded
  failed
  cancelled
  blocked
}

enum DecisionStatus {
  pending
  approved
  rejected
  overridden
  expired
}

enum RiskCategory {
  payment_failed
  payment_expired
  checkout_abandoned
  subscription_lapsed
  refund_requested
  other
}

enum Priority {
  low
  medium
  high
  critical
}

enum AttributionStatus {
  pending
  attributed
  unattributed
  rejected
}

enum AttributionSource {
  payment_retry
  payment_link
  manual
  temporal
}

enum AuditActorType {
  system
  ai_agent
  merchant
  webhook
}

// --- Models -------------------------------------------------------

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  industry  String   @default("ecommerce")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Contact Frequency Policy (Feature 4) ---
  /** Max customer-facing contacts per customer per rolling 24h window. */
  maxContactsPerDay         Int @default(3)
  /** Max customer-facing contacts per customer per rolling 7-day window. */
  maxContactsPerWeek        Int @default(7)
  /** Minimum minutes between consecutive contacts to the same customer. */
  minContactIntervalMinutes Int @default(60)

  customers    Customer[]
  payments     Payment[]
  checkouts    Checkout[]
  subscriptions Subscription[]
  recoveryCases RecoveryCase[]
  communicationEvents CommunicationEvent[]

  @@index([email])
}

model Customer {
  id            String   @id @default(cuid())
  merchantId    String
  email         String
  phone         String   @default("")
  displayName   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Communication Consent (Feature 5) ---
  /** Global do-not-contact flag. When true, ALL customer-facing communications are blocked. */
  doNotContact           Boolean   @default(false)
  /** Per-channel opt-out flags. Null = use global doNotContact. True = opted out. */
  emailOptOut            Boolean   @default(false)
  smsOptOut              Boolean   @default(false)
  whatsappOptOut         Boolean   @default(false)
  voiceOptOut            Boolean   @default(false)
  /** When the customer last opted out (any channel). */
  optedOutAt             DateTime?
  /** Free-text reason for opt-out (e.g. "too many messages"). */
  optOutReason           String   @default("")
  /** Who set the preference: MERCHANT, CUSTOMER, SYSTEM, IMPORT. */
  optOutSource           String   @default("SYSTEM")

  merchant     Merchant              @relation(fields: [merchantId], references: [id])
  payments     Payment[]
  checkouts    Checkout[]
  subscriptions Subscription[]
  communicationEvents  CommunicationEvent[]

  @@unique([merchantId, email])
  @@index([merchantId])
  @@index([email])
  @@index([merchantId, doNotContact])
}

model Payment {
  id               String        @id @default(cuid())
  merchantId       String
  customerId       String
  // External reference from the payment provider (e.g. Razorpay payment_id)
  externalId       String        @unique @default("")
  amount           Int           // in paise
  currency         String        @default("INR")
  status           PaymentStatus @default(created)
  method           PaymentMethod?
  // Short failure reason from the provider, e.g. "TIMED_OUT"
  failureCode      String        @default("")
  failureReason    String        @default("")
  amountRefunded   Int           @default(0) // in paise
  description      String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  merchant              Merchant              @relation(fields: [merchantId], references: [id])
  customer              Customer              @relation(fields: [customerId], references: [id])
  recoveryCase          RecoveryCase?
  recoveryAttributions  RecoveryAttribution[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Checkout {
  id          String         @id @default(cuid())
  merchantId  String
  customerId  String
  amount      Int            // in paise
  currency    String         @default("INR")
  status      CheckoutStatus @default(created)
  // Items in the cart as a JSON string — kept minimal, expanded later if needed
  itemsJson   String         @default("[]")
  abandonedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id             String             @id @default(cuid())
  merchantId     String
  customerId     String
  // External subscription ID from the payment provider
  externalId     String             @default("")
  amount         Int                // in paise, per billing cycle
  currency       String             @default("INR")
  status         SubscriptionStatus @default(active)
  // How many times a payment retry has been attempted
  retryCount     Int                @default(0)
  currentPeriodStart DateTime       @default(now())
  currentPeriodEnd   DateTime       @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status])
}

model RecoveryCase {
  id                   String             @id @default(cuid())
  merchantId           String
  // Which entity triggered this case — one of these will be non-null
  paymentId            String?           @unique
  checkoutId           String?
  subscriptionId       String?
  // Amount at risk (in paise)
  amountAtRisk         Int
  currency             String             @default("INR")
  category             RiskCategory
  priority             Priority           @default(medium)
  status               RecoveryCaseStatus @default(detected)
  recoveryProbability  Float              @default(0)
  // Net amount actually recovered (in paise)
  recoveredAmount      Int                @default(0)
  detectedAt           DateTime           @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  payment           Payment?           @relation(fields: [paymentId], references: [id])
  agentDecisions              AgentDecision[]
  recoveryAttempts            RecoveryAttempt[]
  recoveryAttributions        RecoveryAttribution[]
  probabilityEstimates        RecoveryProbabilityEstimate[]
  auditEvents                 AuditEvent[]
  communicationEvents         CommunicationEvent[]

  @@index([merchantId, status])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([detectedAt])
}

model AgentDecision {
  id                   String         @id @default(cuid())
  recoveryCaseId       String
  // What the agent observed about the case
  observation          String
  // Root cause identified
  diagnosis            String
  // Structured reasoning as JSON — flexible for future AI output
  reasoningJson        String         @default("{}")
  recommendedAction    RecoveryAction
  // 0.0 to 1.0
  confidence           Float
  // 0.0 to 1.0
  recoveryProbability  Float          @default(0)
  status               DecisionStatus @default(pending)
  // If a merchant approved/rejected, who and when
  reviewedBy           String         @default("")
  reviewedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  recoveryAttempts RecoveryAttempt[]
  probabilityEstimates RecoveryProbabilityEstimate[]

  @@index([recoveryCaseId])
  @@index([status])
}

model RecoveryAttempt {
  id                 String               @id @default(cuid())
  recoveryCaseId     String
  agentDecisionId    String?
  action             RecoveryAction
  status             RecoveryAttemptStatus @default(pending)
  // Sequential attempt number for this recovery case (1-based)
  attemptNumber      Int                   @default(1)
  // Amount recovered by this specific attempt (in paise)
  recoveredAmount    Int                   @default(0)
  // Short reason if the attempt failed
  failureReason      String               @default("")
  // External reference (e.g. Razorpay refund_id, retry payment_id)
  externalRef        String               @default("")
  // BullMQ job ID for tracing
  jobId              String               @default("")
  // Whether this execution was simulated (test mode)
  simulated          Boolean              @default(false)
  // When this attempt was scheduled for execution
  scheduledAt        DateTime?
  // When the worker started processing
  startedAt          DateTime?
  attemptedAt        DateTime             @default(now())
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  recoveryCase       RecoveryCase          @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  agentDecision      AgentDecision?       @relation(fields: [agentDecisionId], references: [id])
  recoveryAttributions RecoveryAttribution[]
  communicationEvent  CommunicationEvent?

  @@index([recoveryCaseId])
  @@index([agentDecisionId])
  @@index([status])
  @@index([attemptedAt])
  @@index([recoveryCaseId, attemptNumber])
}

model AuditEvent {
  id         String         @id @default(cuid())
  // The recovery case this event relates to (null for system-level events)
  caseId     String?
  actorType  AuditActorType @default(system)
  actorId    String         @default("")
  eventType  String
  entityType String         @default("")
  entityId   String         @default("")
  action     String
  // Human-readable description
  details    String         @default("")
  // Structured metadata as JSON
  metadataJson String        @default("{}")
  createdAt  DateTime       @default(now())

  recoveryCase RecoveryCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([eventType])
  @@index([actorType])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// =================================================================
// Communication Events (Feature 4)
//
// Tracks every customer-facing communication sent by the recovery
// system. This is DISTINCT from RecoveryAttempt — a RecoveryAttempt
// may or may not result in a CommunicationEvent (e.g. no_action,
// update_payment_method do not contact the customer).
//
// Only SENT/DELIVERED events count toward contact frequency limits.
// QUEUED events ALSO count to prevent burst bypass.
// BLOCKED events are recorded but do NOT count toward limits.
// =================================================================

enum CommunicationChannel {
  email
  sms
  whatsapp
  voice
  push
}

enum CommunicationEventStatus {
  planned
  queued
  sent
  delivered
  failed
  cancelled
  blocked
}

enum CommunicationAction {
  SEND_REMINDER
  SEND_PAYMENT_LINK
  EMAIL
  SMS
  WHATSAPP
  VOICE
}

enum CommunicationBlockReason {
  CONTACT_FREQUENCY_LIMIT
  DO_NOT_CONTACT
  CHANNEL_OPT_OUT
  CASE_ALREADY_RECOVERED
  DAILY_CAP_REACHED
  WEEKLY_CAP_REACHED
  MINIMUM_INTERVAL_NOT_MET
  CUSTOMER_DND_ACTIVE
}

model CommunicationEvent {
  id              String                 @id @default(cuid())
  customerId      String
  merchantId      String
  recoveryCaseId  String?
  recoveryAttemptId String? @unique
  /** Which communication was attempted. */
  action          CommunicationAction
  /** Delivery channel used. */
  channel         CommunicationChannel
  status          CommunicationEventStatus @default(planned)
  /** If blocked, structured reason. */
  blockReason     CommunicationBlockReason?
  /** ISO-8601 when customer becomes eligible again (if blocked). */
  nextEligibleAt  DateTime?
  /** Idempotency key: prevents duplicate contacts on retry/re-execution. */
  idempotencyKey  String                 @default("")
  /** Short human-readable detail. */
  details         String                 @default("")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  customer        Customer               @relation(fields: [customerId], references: [id])
  merchant        Merchant               @relation(fields: [merchantId], references: [id])
  recoveryCase    RecoveryCase?          @relation(fields: [recoveryCaseId], references: [id])
  recoveryAttempt RecoveryAttempt?       @relation(fields: [recoveryAttemptId], references: [id])

  @@unique([idempotencyKey])
  @@index([customerId, createdAt])
  @@index([customerId, channel])
  @@index([merchantId, customerId, createdAt])
  @@index([recoveryCaseId])
  @@index([recoveryAttemptId])
  @@index([status])
  @@index([createdAt])
}

model RecoveryAttribution {
  id                 String            @id @default(cuid())
  recoveryCaseId     String
  recoveryAttemptId  String?
  // The successful payment that recovered revenue
  paymentId          String
  // Amount recovered by this attribution (in paise)
  amount             Int
  status             AttributionStatus @default(pending)
  // How the attribution was determined
  source             AttributionSource
  // 0.0 to 1.0 — confidence in this attribution
  confidence         Float             @default(0)
  // Human-readable explanation
  reason             String            @default("")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  recoveryCase    RecoveryCase    @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  recoveryAttempt RecoveryAttempt? @relation(fields: [recoveryAttemptId], references: [id])
  payment         Payment         @relation(fields: [paymentId], references: [id])

  // Prevent double-counting: same case + same payment can only be attributed once
  @@unique([recoveryCaseId, paymentId])
  @@index([recoveryCaseId])
  @@index([recoveryAttemptId])
  @@index([paymentId])
  @@index([status])
  @@index([source])
}

// =================================================================
// Per-Intervention Recovery Probability Estimates
//
// Stores deterministic probability estimates for each candidate
// intervention on a recovery case. Each estimate is versioned and
// immutable — new analysis runs create new records, never update.
//
// Baseline vs Intervention:
//   isBaseline=true  → P(recover | case, no intervention)
//   isBaseline=false → P(recover | case, specific action)
// =================================================================

model RecoveryProbabilityEstimate {
  id              String         @id @default(cuid())
  recoveryCaseId  String
  agentDecisionId String?
  // Which intervention this estimate is for.
  // Maps to RecoveryAction enum values.
  action          String
  // 0.0 to 1.0 — estimated recovery probability for this intervention
  probability     Float
  // 0.0 to 1.0 — how confident we are in this estimate
  confidence      Float         @default(0)
  // true = baseline (no intervention), false = intervention-specific
  isBaseline      Boolean        @default(false)
  // Structured explainability factors as JSON
  // e.g. [{"signal": "...", "direction": "positive", "detail": "..."}]
  factorsJson     String         @default("[]")
  // Version of the probability model that produced this estimate
  modelVersion    String         @default("1.0.0")
  createdAt       DateTime       @default(now())

  recoveryCase  RecoveryCase  @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  agentDecision AgentDecision? @relation(fields: [agentDecisionId], references: [id])

  @@index([recoveryCaseId])
  @@index([agentDecisionId])
  @@index([action])
  @@index([modelVersion])
}
